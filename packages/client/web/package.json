{
  "name": "@monotykamary/dsh-client-web",
  "description": "Web shell kernel: bootWebShell (module system holding + seed table + two-stage boot + AppRoot gate + app-shell assembly entry), consumed by the apps/web vite entry",
  "version": "0.1.0-rc.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@monotykamary/cordis-plugin-loader": "workspace:^",
    "@monotykamary/dsh-client-ui-renderer": "workspace:^",
    "@monotykamary/dsh-invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@monotykamary/cordis": "workspace:^",
    "typescript": "^6.0.3",
    "@monotykamary/dsh-client-runtime": "workspace:^",
    "@monotykamary/dsh-client-test-runtime": "workspace:^"
  },
  "peerDependencies": {
    "@monotykamary/dsh-invariants": "workspace:^",
    "@monotykamary/cordis": "workspace:^",
    "@monotykamary/cordis-plugin-loader": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/**/*.css",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@monotykamary/dsh-client-modules": "workspace:^",
    "@monotykamary/dsh-client-ui-primitives": "workspace:^",
    "@monotykamary/dsh-client-ui-slots": "workspace:^",
    "@monotykamary/dsh-client-web-react": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
