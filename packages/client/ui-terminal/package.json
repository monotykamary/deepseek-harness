{
  "name": "@monotykamary/dsh-client-ui-terminal",
  "description": "High-throughput xterm.js terminals for the Web workbench and bottom panel",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@monotykamary/dsh-client-locale",
        "@monotykamary/dsh-client-runtime",
        "@monotykamary/dsh-client-ui-conversation",
        "@monotykamary/dsh-client-ui-layout",
        "@monotykamary/dsh-client-ui-theme",
        "@monotykamary/dsh-client-ui-workbench"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/anonymous-pro": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/geist-mono": "5.2.7",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inconsolata": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@xterm/addon-fit": "0.12.0-beta.287",
    "@xterm/addon-image": "0.10.0-beta.287",
    "@xterm/addon-unicode-graphemes": "0.5.0-beta.287",
    "@xterm/addon-web-links": "0.13.0-beta.287",
    "@xterm/addon-webgl": "0.20.0-beta.290",
    "@xterm/xterm": "6.1.0-beta.291"
  },
  "peerDependencies": {
    "@monotykamary/cordis": "workspace:^",
    "@monotykamary/dsh-client-locale": "workspace:^",
    "@monotykamary/dsh-client-runtime": "workspace:^",
    "@monotykamary/dsh-client-ui-conversation": "workspace:^",
    "@monotykamary/dsh-client-ui-layout": "workspace:^",
    "@monotykamary/dsh-client-ui-theme": "workspace:^",
    "@monotykamary/dsh-client-ui-workbench": "workspace:^",
    "@monotykamary/dsh-invariants": "workspace:^",
    "@monotykamary/dsh-terminal-web": "workspace:^"
  },
  "devDependencies": {
    "@monotykamary/cordis": "workspace:^",
    "@monotykamary/dsh-client-locale": "workspace:^",
    "@monotykamary/dsh-client-runtime": "workspace:^",
    "@monotykamary/dsh-client-test-runtime": "workspace:^",
    "@monotykamary/dsh-client-ui-conversation": "workspace:^",
    "@monotykamary/dsh-client-ui-layout": "workspace:^",
    "@monotykamary/dsh-client-ui-primitives": "workspace:^",
    "@monotykamary/dsh-client-ui-slots": "workspace:^",
    "@monotykamary/dsh-client-ui-theme": "workspace:^",
    "@monotykamary/dsh-client-ui-workbench": "workspace:^",
    "@monotykamary/dsh-invariants": "workspace:^",
    "@monotykamary/dsh-terminal-web": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
