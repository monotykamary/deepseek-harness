{
  "name": "@monotykamary/dsh-llm-retry",
  "description": "Provider-routed LLM request retry policy for the DeepSeek Harness",
  "version": "0.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-retry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@monotykamary/dsh-brand": "workspace:^",
    "@monotykamary/dsh-agent": "workspace:^",
    "@monotykamary/dsh-invariants": "workspace:^",
    "@monotykamary/dsh-llm": "workspace:^",
    "@monotykamary/dsh-session": "workspace:^",
    "@monotykamary/dsh-timeout": "workspace:^",
    "@monotykamary/cordis": "workspace:^"
  },
  "dependencies": {
    "@monotykamary/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@monotykamary/dsh-brand": "workspace:^",
    "@monotykamary/cordis-plugin-include": "workspace:^",
    "@monotykamary/cordis-plugin-loader": "workspace:^",
    "@monotykamary/dsh-agent": "workspace:^",
    "@monotykamary/dsh-agent-loop": "workspace:^",
    "@monotykamary/dsh-agent-loop-testkit": "workspace:^",
    "@monotykamary/dsh-invariants": "workspace:^",
    "@monotykamary/dsh-llm": "workspace:^",
    "@monotykamary/dsh-llm-deepseek": "workspace:^",
    "@monotykamary/dsh-llm-mock-server": "workspace:^",
    "@monotykamary/dsh-session": "workspace:^",
    "@monotykamary/dsh-session-persistence-jsonl": "workspace:^",
    "@monotykamary/dsh-session-persistence-sqlite": "workspace:^",
    "@monotykamary/dsh-system-prompt": "workspace:^",
    "@monotykamary/dsh-timeout": "workspace:^",
    "@monotykamary/dsh-tools": "workspace:^",
    "@monotykamary/cordis": "workspace:^"
  }
}
