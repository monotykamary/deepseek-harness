{
  "name": "@monotykamary/dsh-host-workspace-files",
  "description": "Session-authorized workspace listing, bounded-read, and guarded-write Remote",
  "version": "0.1.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/workspace-files"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "@monotykamary/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@monotykamary/cordis": "workspace:^",
    "@monotykamary/dsh-agent": "workspace:^",
    "@monotykamary/dsh-brand": "workspace:^",
    "@monotykamary/dsh-fs": "workspace:^",
    "@monotykamary/dsh-invariants": "workspace:^",
    "@monotykamary/dsh-typert-protocol": "workspace:^"
  },
  "devDependencies": {
    "@monotykamary/cordis": "workspace:^",
    "@monotykamary/dsh-agent": "workspace:^",
    "@monotykamary/dsh-brand": "workspace:^",
    "@monotykamary/dsh-fs": "workspace:^",
    "@monotykamary/dsh-invariants": "workspace:^",
    "@monotykamary/dsh-typert-protocol": "workspace:^"
  }
}
