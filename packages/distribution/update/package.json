{
  "name": "@monotykamary/dsh-distribution-update",
  "description": "Monotonic distribution tracking and detached npm-global or source updates",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/distribution/update"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json",
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/startup.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@monotykamary/dsh-atomic-write": "workspace:^",
    "@monotykamary/dsh-home-paths": "workspace:^",
    "@monotykamary/node-addon-landlock-run": "workspace:^",
    "@monotykamary/schemastery": "workspace:^",
    "semver": "^7.7.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@monotykamary/cordis": "workspace:^",
    "@monotykamary/dsh-invariants": "workspace:^",
    "@monotykamary/dsh-typert-protocol": "workspace:^"
  },
  "devDependencies": {
    "@monotykamary/cordis": "workspace:^",
    "@monotykamary/dsh-invariants": "workspace:^",
    "@monotykamary/dsh-typert-protocol": "workspace:^",
    "@types/semver": "^7.8.0"
  }
}
